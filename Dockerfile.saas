FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MATTERVIS_AUTH_MODE=proxy \
    MATTERVIS_JOB_BACKEND=redis \
    MATTERVIS_OBJECT_STORE_BACKEND=s3

WORKDIR /app
COPY . /app
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir ".[web,saas]"

EXPOSE 50001
CMD ["mat-vis", "serve", "--host", "0.0.0.0", "--port", "50001"]
