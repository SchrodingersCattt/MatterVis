{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattervis.local/schemas/tui-benchmark/oracle-manifest-v1.json",
  "title": "MatterVis TUI benchmark oracle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "license", "cases"],
  "properties": {
    "schema": {"const": "mattervis.tui-benchmark.oracle/v1"},
    "license": {"const": "CC0-1.0"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "fixture_path", "fixture_sha256", "generator", "oracle", "identities", "tasks"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "fixture_path": {"type": "string", "minLength": 1},
          "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "version"],
            "properties": {
              "kind": {"const": "analytic"},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "version", "uses_tui_implementation", "derivation"],
            "properties": {
              "kind": {"const": "analytic"},
              "version": {"type": "string", "minLength": 1},
              "uses_tui_implementation": {"const": false},
              "derivation": {"type": "string", "minLength": 1}
            }
          },
          "identities": {"$ref": "identity_manifest.schema.json"},
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "answer", "tolerances", "observable_by"],
              "properties": {
                "task_id": {"type": "string", "pattern": "^Q[0-9]{2}$"},
                "request": {"type": "object"},
                "answer": {"type": "object"},
                "tolerances": {"type": "object"},
                "observable_by": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
